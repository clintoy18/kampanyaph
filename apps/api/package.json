{
  "name": "@ai-marketer/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "npm run contract:check && prisma generate && tsc -p tsconfig.test-build.json && node --test .test-dist/tests/*.test.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "schema:validate": "prisma validate",
    "db:generate": "prisma generate",
    "contract:generate": "node openapi/contract.mjs",
    "contract:check": "node openapi/contract.mjs --check"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
